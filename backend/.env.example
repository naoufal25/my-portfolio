# Variables d'environnement Backend
# Copiez ce fichier en .env et remplissez les valeurs

# ─── Serveur ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────
# Local :  mongodb://localhost:27017/portfolio
# Atlas :  mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio
MONGO_URI=mongodb://localhost:27017/portfolio

# ─── Email (Nodemailer / Gmail) ───────────────────────────────
# Utilisez un "App Password" Gmail, pas votre mot de passe principal
# https://myaccount.google.com/apppasswords
EMAIL_USER=votre@gmail.com
EMAIL_PASS=votre_app_password

# ─── Client ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── JWT (optionnel - pour une section admin future) ──────────
# JWT_SECRET=votre_secret_jwt_super_long_et_complexe
# JWT_EXPIRES_IN=7d
